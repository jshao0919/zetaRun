rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function activeAccount(uid) {
      return !exists(/databases/$(database)/documents/deletedAccounts/$(uid));
    }
    function validSession(sessionId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'startedAtEpochMs', 'durationSeconds', 'elapsedMs', 'score',
          'attempts', 'meanResponseMs', 'bestStreak', 'operations', 'completed', 'inputMode', 'finishedAtEpochMs'
        ])
        && d.id is string && d.id == sessionId && d.id.size() <= 128
        && d.startedAtEpochMs is int && d.startedAtEpochMs >= 0
        && d.finishedAtEpochMs is int && d.finishedAtEpochMs >= d.startedAtEpochMs
        && d.durationSeconds is int && d.durationSeconds >= 1 && d.durationSeconds <= 3600
        && d.elapsedMs is int && d.elapsedMs >= 0 && d.elapsedMs <= 3600000
        && d.score is int && d.score >= 0 && d.score <= 100000
        && d.attempts is int && d.attempts >= d.score && d.attempts <= 100000
        && d.meanResponseMs is int && d.meanResponseMs >= 0 && d.meanResponseMs <= 3600000
        && d.bestStreak is int && d.bestStreak >= 0 && d.bestStreak <= d.score
        && d.operations is list && d.operations.size() >= 1 && d.operations.size() <= 4
        && d.operations.hasOnly(['ADD', 'SUBTRACT', 'MULTIPLY', 'DIVIDE'])
        && d.completed is bool && d.inputMode in ['voice', 'keypad', 'mixed'];
    }
    match /users/{uid}/sessions/{sessionId} {
      allow read, delete: if owns(uid);
      allow create: if owns(uid) && activeAccount(uid) && validSession(sessionId)
        && !exists(/databases/$(database)/documents/users/$(uid)/deletedSessions/$(sessionId));
      // Results are immutable. Idempotent retries may write the identical document.
      allow update: if owns(uid) && activeAccount(uid) && validSession(sessionId) && request.resource.data == resource.data
        && !exists(/databases/$(database)/documents/users/$(uid)/deletedSessions/$(sessionId));
    }
    match /users/{uid}/deletedSessions/{sessionId} {
      allow read: if owns(uid);
      // Random round IDs only. Immutable deletion markers prevent another offline device restoring results.
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['deleted']) && request.resource.data.deleted == true;
    }
    match /deletedAccounts/{uid} {
      allow read: if owns(uid);
      // Kept until a trusted backend can revoke outstanding tokens and safely clean up metadata.
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['deleted']) && request.resource.data.deleted == true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
